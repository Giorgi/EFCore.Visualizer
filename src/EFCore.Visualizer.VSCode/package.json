{
  "name": "vscode-efcore-visualizer",
  "displayName": "EFCore Visualizer",
  "description": "View the execution plan of an Entity Framework Core query while debugging. SQL Server, PostgreSQL, Oracle and SQLite.",
  "version": "1.0.0",
  "publisher": "GiorgiDalakishvili",
  "license": "GPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Giorgi/EFCore.Visualizer",
    "directory": "src/EFCore.Visualizer.VSCode"
  },
  "homepage": "https://github.com/Giorgi/EFCore.Visualizer",
  "bugs": {
    "url": "https://github.com/Giorgi/EFCore.Visualizer/issues"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "entity framework",
    "ef core",
    "efcore",
    "query plan",
    "execution plan",
    "sql server",
    "postgresql",
    "oracle",
    "sqlite",
    "debugger visualizer"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "efcoreVisualizer.visualizeQuery",
        "title": "Visualize Query Plan",
        "category": "EFCore Visualizer",
        "enablement": "inDebugMode && debugState == 'stopped'",
        "icon": "$(graph)"
      },
      {
        "command": "efcoreVisualizer.refreshQueryPlan",
        "title": "Refresh Query Plan",
        "category": "EFCore Visualizer",
        "icon": "$(refresh)",
        "enablement": "inDebugMode && debugState == 'stopped'"
      },
      {
        "command": "efcoreVisualizer.copyQuerySql",
        "title": "Copy SQL",
        "category": "EFCore Visualizer",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "efcoreVisualizer.visualizeQuery",
          "when": "debugType == 'coreclr' && variableEvaluateNamePresent && variableType =~ /EntityQueryable|IncludableQueryable|InternalDbSet/",
          "group": "z_efcore@1"
        },
        {
          "command": "efcoreVisualizer.visualizeQuery",
          "when": "debugType == 'coreclr' && variableEvaluateNamePresent && variableType =~ /EntityQueryable|IncludableQueryable|InternalDbSet/",
          "group": "inline"
        }
      ],
      "debug/watch/context": [
        {
          "command": "efcoreVisualizer.visualizeQuery",
          "when": "debugType == 'coreclr' && (variableEvaluateNamePresent || watchItemType == 'expression') && variableType =~ /EntityQueryable|IncludableQueryable|InternalDbSet/",
          "group": "z_efcore@1"
        },
        {
          "command": "efcoreVisualizer.visualizeQuery",
          "when": "debugType == 'coreclr' && (variableEvaluateNamePresent || watchItemType == 'expression') && variableType =~ /EntityQueryable|IncludableQueryable|InternalDbSet/",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "efcoreVisualizer.copyQuerySql",
          "when": "activeWebviewPanelId == 'efcoreVisualizer.queryPlan'",
          "group": "navigation@1"
        },
        {
          "command": "efcoreVisualizer.refreshQueryPlan",
          "when": "activeWebviewPanelId == 'efcoreVisualizer.queryPlan'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "efcoreVisualizer.visualizeQuery",
          "when": "debugType == 'coreclr'"
        },
        {
          "command": "efcoreVisualizer.refreshQueryPlan",
          "when": "activeWebviewPanelId == 'efcoreVisualizer.queryPlan'"
        },
        {
          "command": "efcoreVisualizer.copyQuerySql",
          "when": "activeWebviewPanelId == 'efcoreVisualizer.queryPlan'"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "build:helper": "node scripts/build-helper.js",
    "build:fixture": "dotnet build ../../samples/SampleApp/SampleApp.csproj -c Debug",
    "pretest": "npm run compile && npm run build:helper && npm run build:fixture",
    "test": "node out/test/runTest.js",
    "vscode:prepublish": "npm run compile && npm run build:helper && node scripts/copy-license.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "mocha": "11.8.0",
    "typescript": "5.9.3"
  }
}
