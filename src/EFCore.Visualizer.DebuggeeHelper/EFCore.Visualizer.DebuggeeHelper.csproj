<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Debugger-agnostic helper that runs inside the debuggee process.
    It must not depend on Microsoft.VisualStudio.DebuggerVisualizers so that any
    debugger (Visual Studio, VS Code / vsdbg, Rider, ...) can load it with
    Assembly.LoadFrom and call QueryPlanHelper.GetPlanFile / GetQueryFile via func-eval.

    The sources live in IQueryableObjectSource, next to the Visual Studio object source,
    which compiles the same files. This project compiles all of them except the
    Visual Studio specific ones, so a new DatabaseProvider there is picked up here too.
  -->
  <PropertyGroup>
    <TargetFramework>net6</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\IQueryableObjectSource\*.cs"
             Exclude="..\IQueryableObjectSource\EFCoreQueryableObjectSource.cs;..\IQueryableObjectSource\StreamExtensions.cs;..\IQueryableObjectSource\OperationType.cs"
             Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="7.0.0" />
  </ItemGroup>
</Project>
